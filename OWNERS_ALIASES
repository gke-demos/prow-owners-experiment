# File-defined ownership groups (Kubernetes OWNERS_ALIASES format).
# Edit group memberships here, then run ./hack/update-owners.sh to regenerate
# directory OWNERS files (verified in CI by ./hack/verify-owners.sh).

aliases:
  maintainers:
    - moficodes

  root-reviewers:
    - thockin
    - destijl
    - HavenXia

  # Strict /api/ ownership (no_parent_owners: true)
  api-approvers:
    - thockin
    - moficodes
  api-reviewers:
    - HavenXia
    - destijl

  # Scenario 1 & 2 test groups (none of thockin, destijl, or HavenXia has Write
  # access on this repo; all three are invited at Triage, push=false):
  # - thockin and destijl (Greg Castle) are in BOTH dir-a-approvers and
  #   dir-b-approvers (tests Tim #1: single common non-Write approver across A + B).
  # - HavenXia is in dir-c-approvers (tests Tim #2: disjoint non-Write approvers
  #   across dir-a + dir-c, requiring one of {thockin, destijl} AND HavenXia).
  dir-a-approvers:
    - thockin
    - destijl
  dir-a-reviewers:
    - HavenXia

  dir-b-approvers:
    - thockin
    - destijl
  dir-b-reviewers:
    - HavenXia

  dir-c-approvers:
    - HavenXia
  dir-c-reviewers:
    - thockin
    - destijl

  # Subsystem slice inheriting root `maintainers` (/site/ and /docs/)
  site-approvers:
    - HavenXia
    - destijl
  site-reviewers:
    - thockin
